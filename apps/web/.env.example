# PROTÉGÉ web app — local environment template.
# Copy to `.env.local` (git-ignored) and fill in. Never commit a real one.

# --- P10 session-service origin (roadmap P10/P15). Server-only -- never
# NEXT_PUBLIC_*, since the browser only ever talks to the same-origin proxy
# at /api/protege (see src/app/api/protege/[...path]/route.ts). ---
PROTEGE_API_BASE_URL=http://127.0.0.1:8300

# --- Auth (roadmap P10 COPPA design: a parent signs in via Clerk; the
# child plays under that session). Same Clerk application as the backend's
# CLERK_SECRET_KEY/CLERK_PUBLISHABLE_KEY (see the root .env.example and
# docs/P10_SESSION_API.md) -- Next.js needs its own copies because it reads
# env from apps/web/.env.local, not the repo-root .env. Leave both blank to
# run every existing P12/P13/P14 route (/world, /gallery, /(parent)/home)
# with no auth at all; the (child)/garden and (child)/session routes need
# both set to reach a real backend. ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
