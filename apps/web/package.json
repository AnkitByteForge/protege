{
  "name": "@protege/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:types": "node scripts/generate-contract-types.mjs && prettier --write src/generated/contracts",
    "generate:api-types": "openapi-typescript ../../services/session/openapi.json -o src/generated/api/schema.ts && prettier --write src/generated/api"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "openapi-typescript": "^7.5.0",
    "postcss": "^8.5.28",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
