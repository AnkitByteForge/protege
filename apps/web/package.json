    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
