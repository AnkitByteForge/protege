{
  "components": {
    "schemas": {
      "AnswerSubmittedEvent": {
        "description": "The child answered the currently-presented item. ``response_text``\nis validated server-side (``protege.learning_engine.validate_answer``)\nagainst that item's authored correct answer -- never trusted, and the\ncorrect answer itself is never present in this or any request payload.",
        "properties": {
          "item_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Item Id",
            "type": "string"
          },
          "response_text": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Response Text",
            "type": "string"
          },
          "type": {
            "const": "answer_submitted",
            "default": "answer_submitted",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "response_text"
        ],
        "title": "AnswerSubmittedEvent",
        "type": "object"
      },
      "CardExplanation": {
        "description": "Explanation chosen from the 3 authored cards (§19.2).",
        "properties": {
          "card_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Card Ids",
            "type": "array"
          },
          "id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "modality": {
            "const": "explanation_card",
            "default": "explanation_card",
            "title": "Modality",
            "type": "string"
          },
          "skill_code": {
            "anyOf": [
              {
                "examples": [
                  "S004",
                  "S001_identify_fraction"
                ],
                "pattern": "^S\\d{3}(_[a-z][a-z0-9_]*)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Skill Code"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "required": [
          "card_ids"
        ],
        "title": "CardExplanation",
        "type": "object"
      },
      "DeletionRequestOut": {
        "properties": {
          "parent_id": {
            "format": "uuid",
            "title": "Parent Id",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "const": "recorded",
            "default": "recorded",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "parent_id"
        ],
        "title": "DeletionRequestOut",
        "type": "object"
      },
      "DiagnosisLabel": {
        "description": "One closed-set label from the Diagnostician (§7.3, §38).\n\nThe wire key is ``misconception_id`` (§7.3); the value is the library\ncode (``M003``).",
        "properties": {
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "evidence_span": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Span"
          },
          "misconception_id": {
            "examples": [
              "M003"
            ],
            "pattern": "^M\\d{3}$",
            "title": "Misconception Id",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/MisconceptionState",
            "default": "unresolved"
          }
        },
        "required": [
          "misconception_id",
          "confidence"
        ],
        "title": "DiagnosisLabel",
        "type": "object"
      },
      "DiagnosisResult": {
        "description": "Diagnostician output — closed set only, abstention over guessing (§7.3).",
        "properties": {
          "abstained": {
            "default": false,
            "title": "Abstained",
            "type": "boolean"
          },
          "asr_reliable": {
            "default": true,
            "title": "Asr Reliable",
            "type": "boolean"
          },
          "labels": {
            "items": {
              "$ref": "#/components/schemas/DiagnosisLabel"
            },
            "maxItems": 8,
            "title": "Labels",
            "type": "array"
          },
          "model_run_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Run Id"
          },
          "understanding_signals": {
            "items": {
              "$ref": "#/components/schemas/UnderstandingSignal"
            },
            "title": "Understanding Signals",
            "type": "array"
          }
        },
        "title": "DiagnosisResult",
        "type": "object"
      },
      "EvidenceTreeNodeOut": {
        "description": "One resolved node in a claim's clickable evidence tree (roadmap P20;\nARCHITECTURE.md §17 provenance chain: \"evidence -> source event ->\noriginating session/turn\"). Built fresh on every read from\n``EvidenceRepository.resolve_claim`` -- never stored a second time.",
        "properties": {
          "event_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Type"
          },
          "evidence_id": {
            "title": "Evidence Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "occurred_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurred At"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "session_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "turn_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turn Id"
          },
          "weight": {
            "title": "Weight",
            "type": "number"
          }
        },
        "required": [
          "evidence_id",
          "kind",
          "weight",
          "payload",
          "occurred_at",
          "event_type",
          "session_id",
          "turn_id"
        ],
        "title": "EvidenceTreeNodeOut",
        "type": "object"
      },
      "ExplanationGivenEvent": {
        "description": "A teach-back / readiness / reflection explanation, in any of the\nfour authored modalities (see :data:`~.session.Explanation`).",
        "properties": {
          "explanation": {
            "discriminator": {
              "mapping": {
                "explanation_card": "#/components/schemas/CardExplanation",
                "manipulative": "#/components/schemas/ManipulativeExplanation",
                "text": "#/components/schemas/TextExplanation",
                "voice": "#/components/schemas/VoiceExplanation"
              },
              "propertyName": "modality"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/VoiceExplanation"
              },
              {
                "$ref": "#/components/schemas/TextExplanation"
              },
              {
                "$ref": "#/components/schemas/ManipulativeExplanation"
              },
              {
                "$ref": "#/components/schemas/CardExplanation"
              }
            ],
            "title": "Explanation"
          },
          "type": {
            "const": "explanation_given",
            "default": "explanation_given",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "explanation"
        ],
        "title": "ExplanationGivenEvent",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HintRequestedEvent": {
        "description": "The child asked for the available hint (valid only while the server\nconsiders one available -- i.e. session state ``COACH_ASSIST``).",
        "properties": {
          "type": {
            "const": "hint_requested",
            "default": "hint_requested",
            "title": "Type",
            "type": "string"
          }
        },
        "title": "HintRequestedEvent",
        "type": "object"
      },
      "ItemPromptOut": {
        "properties": {
          "item_id": {
            "title": "Item Id",
            "type": "string"
          },
          "stem": {
            "title": "Stem",
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "stem"
        ],
        "title": "ItemPromptOut",
        "type": "object"
      },
      "LearnerEnsureOut": {
        "description": "``POST /v1/learners/ensure`` (roadmap product-entry milestone): the\ncaller's single default learner, created on first call. Deliberately\nminimal -- the frontend needs only the id to reach ``/garden``/\n``POST /v1/sessions`` and a display label, nothing about the owning\nparent.",
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "learner_id": {
            "format": "uuid",
            "title": "Learner Id",
            "type": "string"
          }
        },
        "required": [
          "learner_id",
          "display_name"
        ],
        "title": "LearnerEnsureOut",
        "type": "object"
      },
      "LearnerStateOut": {
        "properties": {
          "learner_id": {
            "format": "uuid",
            "title": "Learner Id",
            "type": "string"
          },
          "misconceptions": {
            "items": {
              "$ref": "#/components/schemas/MisconceptionBeliefOut"
            },
            "title": "Misconceptions",
            "type": "array"
          },
          "skills": {
            "items": {
              "$ref": "#/components/schemas/SkillMasteryOut"
            },
            "title": "Skills",
            "type": "array"
          }
        },
        "required": [
          "learner_id",
          "skills",
          "misconceptions"
        ],
        "title": "LearnerStateOut",
        "type": "object"
      },
      "ManipulativeAction": {
        "description": "One manipulative interaction in a trace (§38: ``{t, action, target}``).\n\nThe trace is a first-class diagnostic input, equal in standing to speech\n(roadmap P13): a child who aligns two bars has demonstrated understanding\nwithout a word.",
        "properties": {
          "action": {
            "examples": [
              "drag",
              "align",
              "snap"
            ],
            "title": "Action",
            "type": "string"
          },
          "t": {
            "description": "Seconds since the item was presented.",
            "minimum": 0.0,
            "title": "T",
            "type": "number"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          },
          "targets": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Targets"
          }
        },
        "required": [
          "t",
          "action"
        ],
        "title": "ManipulativeAction",
        "type": "object"
      },
      "ManipulativeExplanation": {
        "description": "Non-verbal teach-back: the child shows it with the manipulative.",
        "properties": {
          "id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "manipulative_trace": {
            "items": {
              "$ref": "#/components/schemas/ManipulativeAction"
            },
            "minItems": 1,
            "title": "Manipulative Trace",
            "type": "array"
          },
          "modality": {
            "const": "manipulative",
            "default": "manipulative",
            "title": "Modality",
            "type": "string"
          },
          "skill_code": {
            "anyOf": [
              {
                "examples": [
                  "S004",
                  "S001_identify_fraction"
                ],
                "pattern": "^S\\d{3}(_[a-z][a-z0-9_]*)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Skill Code"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "required": [
          "manipulative_trace"
        ],
        "title": "ManipulativeExplanation",
        "type": "object"
      },
      "ManipulativeMovedEvent": {
        "description": "A structured manipulative interaction trace (roadmap P13: \"equal in\nstanding to speech\" as diagnostic evidence).",
        "properties": {
          "trace": {
            "items": {
              "$ref": "#/components/schemas/ManipulativeAction"
            },
            "minItems": 1,
            "title": "Trace",
            "type": "array"
          },
          "type": {
            "const": "manipulative_moved",
            "default": "manipulative_moved",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "trace"
        ],
        "title": "ManipulativeMovedEvent",
        "type": "object"
      },
      "MisconceptionBeliefOut": {
        "properties": {
          "misconception_code": {
            "title": "Misconception Code",
            "type": "string"
          },
          "p_holds": {
            "title": "P Holds",
            "type": "number"
          },
          "resolved_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
