        "type": "object"
      },
      "MisconceptionState": {
        "enum": [
          "unresolved",
          "resolved"
        ],
        "title": "MisconceptionState",
        "type": "string"
      },
      "NotYetAvailableOut": {
        "description": "Roadmap P10: \"If those artifacts do not yet have writers ... return\nthe canonical not-yet-available representation instead of fabricating\ndata.\" Used for ``/proof`` and ``/tutor-brief`` until P20/P21 exist.",
        "properties": {
          "learner_id": {
            "format": "uuid",
            "title": "Learner Id",
            "type": "string"
          },
          "message": {
            "default": "This isn't ready yet -- proof artifacts are generated by a later phase.",
            "title": "Message",
            "type": "string"
          },
          "status": {
            "const": "not_yet_available",
            "default": "not_yet_available",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "learner_id"
        ],
        "title": "NotYetAvailableOut",
        "type": "object"
      },
      "ProofCardOut": {
        "description": "The parent proof card (roadmap P20). No score, no percentage, no\nletter grade appears anywhere in this shape -- only claims, evidence,\nmandatory caveats, and one concrete action.",
        "properties": {
          "claims": {
            "items": {
              "$ref": "#/components/schemas/ProofClaimOut"
            },
            "title": "Claims",
            "type": "array"
          },
          "duration_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Minutes"
          },
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "learner_id": {
            "format": "uuid",
            "title": "Learner Id",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          },
          "tonight_action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tonight Action"
          }
        },
        "required": [
          "learner_id",
          "session_id",
          "generated_at",
          "duration_minutes",
          "claims",
          "tonight_action"
        ],
        "title": "ProofCardOut",
        "type": "object"
      },
      "ProofClaimOut": {
        "description": "One ``ProofClaim`` plus its resolved evidence tree (roadmap P20:\n\"every claim expands to its evidence tree\"). ``transfer_verified`` is\nsurfaced as its own field, deliberately never folded into ``text`` --\nroadmap P20: \"transfer_verified shown separately\".",
        "properties": {
          "caveats": {
            "items": {
              "type": "string"
            },
            "title": "Caveats",
            "type": "array"
          },
          "claim_id": {
            "title": "Claim Id",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceTreeNodeOut"
            },
            "title": "Evidence",
            "type": "array"
          },
          "sentences": {
            "items": {
              "$ref": "#/components/schemas/ProofSentenceOut"
