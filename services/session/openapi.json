          "skill_code": {
            "title": "Skill Code",
            "type": "string"
          },
          "transfer_verified": {
            "title": "Transfer Verified",
            "type": "boolean"
          },
          "unaided_correct": {
            "title": "Unaided Correct",
            "type": "integer"
          }
        },
        "required": [
          "skill_code",
          "p_known",
          "evidence_count",
          "unaided_correct",
          "transfer_verified",
          "computed_at"
        ],
        "title": "SkillMasteryOut",
        "type": "object"
      },
      "SproutConfidenceShown": {
        "description": "Confidence Sprout displays about his (wrong) belief (addendum §7.3).",
        "enum": [
          "high",
          "medium",
          "low"
        ],
        "title": "SproutConfidenceShown",
        "type": "string"
      },
      "SproutPresentationEmotion": {
        "description": "Rig presentation state, driven by resolution belief (§8.3).\n\nSprout is never `delighted` before the misconception clears — the\nfrontend maps this enum straight onto the SVG rig.",
        "enum": [
          "confused",
          "thinking",
          "dawning",
          "delighted"
        ],
        "title": "SproutPresentationEmotion",
        "type": "string"
      },
      "SproutTurn": {
        "description": "One in-character Sprout line (addendum §2.5; §7.3).\n\nThe addendum sample types ``exhibits``/``emotion``/``confidence_shown``\nas bare ``str``; the contracts use the closed enums instead. Sprout may\nnot state the correct answer while the misconception is unresolved —\nthat check is the deterministic answer-leak validator's job, not this\nschema's.",
        "properties": {
          "confidence_shown": {
            "$ref": "#/components/schemas/SproutConfidenceShown"
          },
          "emotion": {
            "$ref": "#/components/schemas/SproutPresentationEmotion"
          },
          "exhibits": {
            "examples": [
              "M003"
            ],
            "pattern": "^M\\d{3}$",
            "title": "Exhibits",
            "type": "string"
          },
          "utterance": {
            "description": "At most 30 words (§7.3).",
            "title": "Utterance",
            "type": "string"
          }
        },
        "required": [
          "utterance",
          "exhibits",
          "emotion",
          "confidence_shown"
        ],
        "title": "SproutTurn",
        "type": "object"
      },
      "TextExplanation": {
        "description": "Typed explanation.",
        "properties": {
          "id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "modality": {
            "const": "text",
            "default": "text",
            "title": "Modality",
            "type": "string"
          },
          "skill_code": {
            "anyOf": [
              {
                "examples": [
                  "S004",
                  "S001_identify_fraction"
                ],
                "pattern": "^S\\d{3}(_[a-z][a-z0-9_]*)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Skill Code"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "TextExplanation",
        "type": "object"
      },
      "UnderstandingSignal": {
        "description": "Closed-set positive signals (§38 attested; extended via P3/P6 review).",
        "enum": [
          "inverse_denominator_relationship",
          "partitioning_language"
        ],
        "title": "UnderstandingSignal",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VoiceExplanation": {
        "description": "Spoken explanation; ASR confidence gates diagnosis (§7.3 abstention).",
        "properties": {
          "asr_confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Asr Confidence",
            "type": "number"
          },
          "id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "modality": {
            "const": "voice",
            "default": "voice",
            "title": "Modality",
            "type": "string"
          },
          "skill_code": {
            "anyOf": [
              {
                "examples": [
                  "S004",
                  "S001_identify_fraction"
                ],
                "pattern": "^S\\d{3}(_[a-z][a-z0-9_]*)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Skill Code"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "asr_confidence"
        ],
        "title": "VoiceExplanation",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "PROTÉGÉ Session Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    },
    "/v1/learners/ensure": {
      "post": {
        "description": "Product-entry bootstrap: get-or-create the signed-in parent's single\ndefault learner. Ownership/identity is ``actor.clerk_user_id`` alone\n(never a client-supplied id, never ``email``) -- see\n``LearnerRepository.get_or_create_parent_for_clerk_user``'s docstring.\nIdempotent by construction: a repeat call for the same Clerk user finds\nthe existing parent/learner rather than creating new ones.",
        "operationId": "ensure_learner_route_v1_learners_ensure_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearnerEnsureOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ensure Learner Route",
        "tags": [
          "learners"
        ]
      }
    },
    "/v1/learners/{learner_id}/proof": {
      "get": {
        "description": "The parent proof card (roadmap P20): the most recent\n``ProofArtifact`` for this learner, with every claim's evidence tree\nresolved fresh (never a stored second copy -- see\n``repositories/proof.py``). Same authz shape as ``/state`` above:\ntutor/admin bypass ownership (no time-boxed grant ledger exists yet,\nsame disclosed P10 gap ``authz.require_tutor_or_admin`` already\ndocuments); a parent may only reach their own linked learner.\n\nFalls back to the same canonical ``NotYetAvailableOut`` roadmap P10\nalready established -- before any session completes, or if the async\nP20 job has not yet run, there is still nothing to fabricate.",
        "operationId": "get_learner_proof_route_v1_learners__learner_id__proof_get",
        "parameters": [
          {
            "in": "path",
            "name": "learner_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Learner Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ProofCardOut"
                    },
                    {
                      "$ref": "#/components/schemas/NotYetAvailableOut"
                    }
                  ],
                  "title": "Response Get Learner Proof Route V1 Learners  Learner Id  Proof Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Learner Proof Route",
        "tags": [
          "learners"
        ]
      }
    },
    "/v1/learners/{learner_id}/state": {
      "get": {
        "description": "Parent/tutor-scoped mastery view (architecture §23), read straight\noff P9's authoritative ``mastery_estimates``/``misconception_beliefs``\n-- no client-side reconstruction, no re-derivation here.",
        "operationId": "get_learner_state_route_v1_learners__learner_id__state_get",
        "parameters": [
          {
            "in": "path",
            "name": "learner_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Learner Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearnerStateOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Learner State Route",
        "tags": [
          "learners"
        ]
      }
    },
    "/v1/learners/{learner_id}/tutor-brief": {
      "get": {
        "description": "Tutor Briefs are generated by P21, which has not shipped. Gated to\ntutor/admin roles (architecture §23: \"Requires time-boxed tutor\ngrant\") -- P10 does not implement the grant ledger itself; see\n``authz.require_tutor_or_admin``'s docstring.",
        "operationId": "get_learner_tutor_brief_route_v1_learners__learner_id__tutor_brief_get",
        "parameters": [
          {
            "in": "path",
            "name": "learner_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Learner Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotYetAvailableOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Learner Tutor Brief Route",
        "tags": [
          "learners"
        ]
      }
    },
    "/v1/parents/{parent_id}/deletion-request": {
      "post": {
        "operationId": "deletion_request_route_v1_parents__parent_id__deletion_request_post",
        "parameters": [
          {
            "in": "path",
            "name": "parent_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Parent Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletionRequestOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Deletion Request Route",
        "tags": [
          "parents"
        ]
      }
    },
    "/v1/sessions": {
      "post": {
        "operationId": "create_session_route_v1_sessions_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionCreateIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Session Route",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/sessions/{session_id}": {
      "get": {
        "operationId": "get_session_route_v1_sessions__session_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Session Route",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/sessions/{session_id}/complete": {
      "post": {
        "operationId": "complete_session_route_v1_sessions__session_id__complete_post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Complete Session Route",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/sessions/{session_id}/events": {
      "post": {
        "operationId": "submit_event_route_v1_sessions__session_id__events_post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "discriminator": {
                  "mapping": {
                    "answer_submitted": "#/components/schemas/AnswerSubmittedEvent",
                    "explanation_given": "#/components/schemas/ExplanationGivenEvent",
                    "hint_requested": "#/components/schemas/HintRequestedEvent",
                    "manipulative_moved": "#/components/schemas/ManipulativeMovedEvent"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/AnswerSubmittedEvent"
                  },
                  {
                    "$ref": "#/components/schemas/ExplanationGivenEvent"
                  },
                  {
                    "$ref": "#/components/schemas/ManipulativeMovedEvent"
                  },
                  {
                    "$ref": "#/components/schemas/HintRequestedEvent"
                  }
                ],
                "title": "Payload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionEventOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Event Route",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/sessions/{session_id}/stream": {
      "get": {
        "operationId": "stream_session_route_v1_sessions__session_id__stream_get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stream Session Route",
        "tags": [
          "sessions"
        ]
      }
    }
  }
}
