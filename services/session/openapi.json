            "title": "Sentences",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "threshold_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold Id"
          },
          "transfer_verified": {
            "title": "Transfer Verified",
            "type": "boolean"
          }
        },
        "required": [
          "claim_id",
          "text",
          "threshold_id",
          "sentences",
          "caveats",
          "transfer_verified",
          "evidence"
        ],
        "title": "ProofClaimOut",
        "type": "object"
      },
      "ProofSentenceOut": {
        "properties": {
