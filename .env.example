# PROTÉGÉ — local environment template.
# Copy to `.env` (git-ignored) and fill in. Never commit a real .env (AGENTS.md: never commit secrets).

# --- Runtime AI providers (addendum §7.2; keys are secrets, env only) ---
NVIDIA_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# --- Offline authoring ONLY — never a runtime dependency (addendum §9.4) ---
ANTHROPIC_API_KEY=

# --- Data ---
# asyncpg driver for app + Alembic; docker-compose maps Postgres on
# localhost:5433 (not 5432, to coexist with other local projects).
# `ssl=disable` is needed locally: asyncpg 0.30+ prefers SSL and Windows'
# Docker port proxy resets that handshake. Use ssl=require in production.
DATABASE_URL=postgresql+asyncpg://protege:protege@localhost:5433/protege?ssl=disable

# --- Object storage (StorageAdapter arrives later; env slots per roadmap P0) ---
AWS_REGION=us-east-1
S3_BUCKET=

# --- Service ---
LOG_LEVEL=INFO
# OTEL_CONSOLE_EXPORT=false

# --- Auth (roadmap P10 — Clerk-issued session JWTs; see docs/P10_SESSION_API.md) ---
# Secret: Clerk Dashboard -> API Keys -> Secret key.
CLERK_SECRET_KEY=
# Public: Clerk Dashboard -> API Keys -> Publishable key (also used client-side; safe to expose).
CLERK_PUBLISHABLE_KEY=
# Secret-ish, but not a credential by itself: Clerk Dashboard -> API Keys -> "Show JWT public key"
# (PEM). Set this to verify tokens networkless (no per-request call to Clerk); leave blank to fall
# back to fetching + caching the JWKS from Clerk's Backend API using CLERK_SECRET_KEY.
CLERK_JWT_KEY=
# Comma-separated origins allowed to present a session token (Clerk's `authorized_parties`).
# e.g. https://app.example.com,http://localhost:3000 — leave blank in local dev.
CLERK_AUTHORIZED_PARTIES=
